# Get these from Firebase Console â†’ Project Settings â†’ Your apps â†’ Web app â†’ SDK snippet
# Do NOT commit the real .env file. Secrets stay out of source control.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Required for public booking verification and submission.
# Firebase App Check Fraud Defense (reCAPTCHA Enterprise): score-based Web site key,
# registered against this Firebase web app. Do not use a classic/v3 key or secret key.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Organisation timezone used for all display/formatting (IANA name)
VITE_ORG_TIMEZONE=Australia/Sydney

# Region the Cloud Functions are deployed to (must match functions/index.js)
VITE_FUNCTIONS_REGION=australia-southeast1

# Public reCAPTCHA Enterprise/Fraud Defense site key registered with Firebase App Check (not the YouTube API key).
